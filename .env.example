# --- Model providers: set one or both -------------------------------------
# With both set, Gemini is tried first and the OpenAI-compatible provider
# takes over whenever Gemini runs out of quota (and the other way round).

# Google Gemini: free key from https://aistudio.google.com/apikey (no card).
# GEMINI_API_KEY="your-gemini-key"
# GEMINI_MODEL: Optional. Without it FORGE picks the newest Flash-Lite model.
# GEMINI_MODEL=""

# Open models through any OpenAI-compatible API.
#   OpenRouter (free models end in ":free"):  https://openrouter.ai/api/v1
#   NVIDIA build.nvidia.com:                  https://integrate.api.nvidia.com/v1
#   Ollama on your own machine (no key):      http://localhost:11434/v1
# LLM_BASE_URL="https://openrouter.ai/api/v1"
# LLM_API_KEY="your-provider-key"
# LLM_MODEL="nvidia/nemotron-3-ultra-550b-a55b:free"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# RATE_LIMIT_MAX: Optional. Analyses allowed per IP per 10 minutes (default 10).
# RATE_LIMIT_MAX="10"

# PORT: Optional. Port the server listens on (default 3000).
# PORT="3000"

# VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY: Optional, set both or neither.
# When set, FORGE requires sign-in and stores ideas per user in Supabase.
# When unset, ideas are kept in the browser only. Both values are public
# (Supabase dashboard > Project Settings > API) and are needed at build time.
# VITE_SUPABASE_URL="https://your-project.supabase.co"
# VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# TAVILY_API_KEY: Optional. Turns on live web search so competitors and market
# claims are backed by real pages. Free plan at tavily.com, no card needed.
# TAVILY_API_KEY="tvly-your-key"

# VITE_API_URL: Optional, build time. Where the browser sends analyses.
# Leave unset when the Node server serves the site; the hosted build points it
# at the Supabase Edge Function.
# VITE_API_URL="https://your-project.supabase.co/functions/v1/analyze"
